# Turns every file of DIST into a gzip-compressed C++ array and writes the
# table that web_assets.h declares to OUT.
#   cmake -DDIST=<web/dist> -DOUT=<web_assets.cpp> -P embed_web.cmake

cmake_minimum_required(VERSION 3.19)  # file(ARCHIVE_CREATE ... COMPRESSION_LEVEL)

if(NOT EXISTS "${DIST}/index.html")
    message(FATAL_ERROR "${DIST}/index.html not found: run `make web-build` first")
endif()

function(mime_of name out_var)
    string(REGEX MATCH "\\.[A-Za-z0-9]+$" ext "${name}")
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".html")
        set(m "text/html; charset=utf-8")
    elseif(ext STREQUAL ".js")
        set(m "text/javascript; charset=utf-8")
    elseif(ext STREQUAL ".css")
        set(m "text/css; charset=utf-8")
    elseif(ext STREQUAL ".json")
        set(m "application/json")
    elseif(ext STREQUAL ".svg")
        set(m "image/svg+xml")
    elseif(ext STREQUAL ".png")
        set(m "image/png")
    elseif(ext STREQUAL ".ico")
        set(m "image/x-icon")
    elseif(ext STREQUAL ".woff2")
        set(m "font/woff2")
    elseif(ext STREQUAL ".txt")
        set(m "text/plain; charset=utf-8")
    else()
        set(m "application/octet-stream")
    endif()
    set(${out_var} "${m}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE files RELATIVE "${DIST}" "${DIST}/*")
list(SORT files)

set(arrays "")
set(table "")
set(i 0)
foreach(f ${files})
    # CMake's own gzip (libarchive), so no gzip program is needed (Windows).
    set(gz "${OUT}.tmp.gz")
    file(ARCHIVE_CREATE OUTPUT "${gz}" PATHS "${DIST}/${f}" FORMAT raw
         COMPRESSION GZip COMPRESSION_LEVEL 9)
    file(READ "${gz}" hex HEX)
    file(REMOVE "${gz}")
    # Header bytes 4-7 are the time of compression: zeroed (as gzip -n does)
    # so the same web gives the same binary.
    string(SUBSTRING "${hex}" 0 8 head)
    string(SUBSTRING "${hex}" 16 -1 tail)
    set(hex "${head}00000000${tail}")
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    mime_of("${f}" mime)
    string(APPEND arrays "const unsigned char asset_${i}[] = {${bytes}};\n")
    string(APPEND table "    {\"/${f}\", \"${mime}\", asset_${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()

file(WRITE "${OUT}" "// Generated by cmake/embed_web.cmake from web/dist. Do not edit.
#include \"web_assets.h\"

namespace ils {
namespace {

${arrays}
const WebAsset assets[] = {
${table}};

}  // namespace

WebAssets embedded_web() { return {assets, ${i}}; }

}  // namespace ils
")
